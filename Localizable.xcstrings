    },
    "Let Dejima see ⌘C" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dejima が ⌘C を見られるようにする"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dejima가 ⌘C를 볼 수 있게 하기"
