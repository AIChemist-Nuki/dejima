    "Drag **%@** to the list above to allow **Accessibility**" : {
      "comment" : "A description of the drag-and-drop feature that allows users to drag an app to the list of apps that can be used with Accessibility.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**%@** を上のリストへドラッグして**アクセシビリティ**を許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "**%@**을(를) 위 목록으로 드래그하여 **손쉬운 사용**을 허용하세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "将 **%@** 拖到上方列表以允许**辅助功能**"
